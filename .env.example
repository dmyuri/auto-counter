# Copie para .env e preencha com os valores reais. O .env nunca e versionado.
# Nenhuma URL da NitTrans entra em arquivo versionado (.spec/constitution.md),
# e o codigo nao tem valor padrao embutido: sem a variavel definida, o sistema
# falha com erro explicito.

# Base URL do servidor de video das cameras. A URL do clipe e derivada do id:
# <base_url>/<id>/last_video.mp4
AUTO_COUNTER_BASE_URL=

# Diretorio onde ficam clipes, banco e planilhas das sessoes.
AUTO_COUNTER_DATA_DIR=
